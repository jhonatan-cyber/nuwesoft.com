# ──────────────────────────────────────────────
# Laravel Configuration
# ──────────────────────────────────────────────
APP_NAME="Nuwesoft"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nuwesoft.nuwesomme.cloud
CHROME_PATH=
NODE_BINARY=
CAPTURE_MAX_PAGES=20

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
# PRODUCCIÓN (dentro del VPS): host interno de docker compose
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=nuwesoft.com
DB_USERNAME=postgres
DB_PASSWORD=

# ──────────────────────────────────────────────
# Desarrollo local contra DB de producción (túnel SSH)
# ──────────────────────────────────────────────
# 1) En .env.local (gitignored), definir:
#      DEV_SSH_HOST=ip-o-dominio-del-vps
#      DEV_SSH_USER=usuario
#      DEV_SSH_PORT=22              # opcional, default 22
#      DEV_SSH_KEY=C:\ruta\a\clave  # opcional si usa agente SSH
# 2) Abrir el túnel:  .\scripts\db-tunnel.ps1 start
#    (expone la DB del VPS en 127.0.0.1:15432, solo localhost)
# 3) En .env local usar:
#      DB_HOST=127.0.0.1
#      DB_PORT=15432
#      + credenciales DB del .env de producción
# Requiere que compose.prod.yaml tenga pgsql publicado en
# 127.0.0.1:15432 dentro del VPS (ya configurado; el 5432 nativo está ocupado).
#
# Credenciales SSH para el túnel (leídas por scripts/db-tunnel.ps1):
DEV_SSH_HOST=
DEV_SSH_USER=
DEV_SSH_PORT=22
DEV_SSH_KEY=

# ──────────────────────────────────────────────
# Cache & Sessions (Redis)
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Queue & WebSockets
# ──────────────────────────────────────────────
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# Enable/disable Reverb WebSocket server (true/false)
REVERB_ENABLED=true

# Number of queue workers to run
QUEUE_WORKERS=1

# ──────────────────────────────────────────────
# Reverb WebSocket
# ──────────────────────────────────────────────
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="${APP_URL}"
REVERB_PORT=8090
REVERB_SCHEME=https

# ──────────────────────────────────────────────
# Mail (SMTP)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@nuwesoft.nuwesomme.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Admin email for contact form notifications
MAIL_ADMIN_ADDRESS=

# ──────────────────────────────────────────────
# Cloudinary (File Uploads)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
# Prefijo por entorno (evita mezclar dev/prod en mismo cloud)
CLOUDINARY_FOLDER_PREFIX=nuwesoft/production
# Legacy single-URL format (alternativa a las 3 vars de arriba)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Nota local: si usas `php artisan serve` sin queue worker, pon QUEUE_CONNECTION=sync
# para ver uploads inmediatos; con `start-dev.bat` ya corre queue:work con database.

REVERB_PORT=8090

# ──────────────────────────────────────────────
# PostHog Analytics (optional)
# ──────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ──────────────────────────────────────────────
# Vite
# ──────────────────────────────────────────────
VITE_APP_URL="${APP_URL}"
