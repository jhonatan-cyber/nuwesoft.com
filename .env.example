# ──────────────────────────────────────────────
# Laravel Configuration
# ──────────────────────────────────────────────
APP_NAME="Nuwesoft"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nuwesoft.nuwesomme.cloud

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=nuwesoft.com
DB_USERNAME=postgres
DB_PASSWORD=

# ──────────────────────────────────────────────
# Cache & Sessions (Redis)
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Queue & WebSockets
# ──────────────────────────────────────────────
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# Enable/disable Reverb WebSocket server (true/false)
REVERB_ENABLED=true

# Number of queue workers to run
QUEUE_WORKERS=1

# ──────────────────────────────────────────────
# Reverb WebSocket
# ──────────────────────────────────────────────
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="${APP_URL}"
REVERB_PORT=8090
REVERB_SCHEME=https

# ──────────────────────────────────────────────
# Mail (SMTP)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@nuwesoft.nuwesomme.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Admin email for contact form notifications
MAIL_ADMIN_ADDRESS=

# ──────────────────────────────────────────────
# Cloudinary (File Uploads)
# ──────────────────────────────────────────────
CLOUDINARY_URL=

# ──────────────────────────────────────────────
# Docker Ports (host-side)
# ──────────────────────────────────────────────
APP_PORT=8080
REVERB_PORT=8090

# ──────────────────────────────────────────────
# PostHog Analytics (optional)
# ──────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ──────────────────────────────────────────────
# Vite
# ──────────────────────────────────────────────
VITE_APP_URL="${APP_URL}"
