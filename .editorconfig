# ──────────────────────────────────────────────
#  Nuwesoft.com — EditorConfig
#  https://editorconfig.org
# ──────────────────────────────────────────────
root = true

# ── Default (all files) ────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# ── PHP ────────────────────────────────────────
[*.php]
indent_size = 4

# ── JavaScript / TypeScript ────────────────────
[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2

# ── Vue ────────────────────────────────────────
[*.vue]
indent_size = 2

# ── Blade templates ────────────────────────────
[*.blade.php]
indent_size = 4

# ── CSS / SCSS ─────────────────────────────────
[*.{css,scss,less}]
indent_size = 2

# ── HTML ───────────────────────────────────────
[*.html]
indent_size = 2

# ── JSON ───────────────────────────────────────
[*.json]
indent_size = 4

# ── YAML ───────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

[compose.yaml]
indent_size = 4

[compose*.yaml]
indent_size = 4

# ── Markdown ───────────────────────────────────
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ── Makefile (must use tabs) ──────────────────
[Makefile]
indent_style = tab

# ── Shell scripts ──────────────────────────────
[*.{sh,bash}]
indent_size = 4

# ── Docker ─────────────────────────────────────
[Dockerfile*]
indent_size = 4

# ── Env files ──────────────────────────────────
[.env*]
insert_final_newline = true
