# ========================================================
# STAGE 1: Descarga de Dependencias PHP (Composer Builder)
# ========================================================
FROM composer:2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040 AS composer-builder

WORKDIR /app

# Copiar archivos de dependencias de PHP
COPY composer.json composer.lock ./

# Instalar dependencias de Laravel para producción (incluyendo Ziggy)
RUN composer install --no-dev --no-interaction --no-autoloader --no-scripts --ignore-platform-reqs

# ========================================================
# STAGE 2: Compilación de Assets Frontend (Vite Builder)
# ========================================================
FROM oven/bun:latest@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS frontend-builder

WORKDIR /app

# Copiar archivos de dependencias de frontend
COPY package.json bun.lock tsconfig.json ./

# Instalar dependencias de JS
RUN bun install

# Copiar la carpeta vendor del Stage 1 (Necesario para que Vite/Ziggy compilen)
COPY --from=composer-builder /app/vendor ./vendor

# Copiar código del frontend y archivos de configuración
COPY resources/ ./resources/
COPY vite.config.js tailwind.config.js postcss.config.js ./

# Compilar assets con Vite para producción
RUN bun run build

# ========================================================
# STAGE 3: Dependencias Node de Producción (Crawlee + Playwright Core)
# ========================================================
FROM oven/bun:latest@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS node-deps

WORKDIR /app

# Mismos artefactos que el builder de frontend: un único lockfile (bun.lock)
COPY package.json bun.lock ./

# Solo dependencias de producción, sin scripts de instalación
RUN bun install --production --frozen-lockfile --ignore-scripts

# ========================================================
# STAGE 4: Aplicación PHP + Nginx en Producción
# ========================================================
FROM webdevops/php-nginx:8.4-alpine@sha256:f1f19fa820fae05fefe63d71a8df39644f5751969587addc876b33281536d423

WORKDIR /var/www/html

# Navegador aislado para el analizador de proyectos protegidos (node en tiempo de ejecución, sin npm).
RUN apk add --no-cache nodejs chromium nss freetype harfbuzz ca-certificates ttf-freefont postgresql-client

# Configuración de variables de entorno de la imagen webdevops
ENV WEB_DOCUMENT_ROOT=/var/www/html/public \
    WEB_DOCUMENT_INDEX=index.php \
    PHP_DISMOD=xdebug \
    LOG_STDOUT=/dev/stdout \
    LOG_STDERR=/dev/stderr

# Copiar todo el código de la aplicación Laravel con el dueño correcto
COPY --chown=application:application . .

# Solo dependencias Node de producción (Playwright Core + Crawlee, sin descargar otro navegador),
# instaladas con el único lockfile del proyecto y sin scripts de post-instalación.
COPY --from=node-deps --chown=application:application /app/node_modules ./node_modules

# Copiar dependencias de Composer ya descargadas en el Stage 1 con el dueño correcto
COPY --from=composer-builder --chown=application:application /app/vendor ./vendor

# Copiar los assets de frontend compilados en el Stage 2 con el dueño correcto
COPY --from=frontend-builder --chown=application:application /app/public/build ./public/build

# Volver a correr composer install para generar el autoloader optimizado y correr scripts
RUN composer install --no-dev --no-interaction --optimize-autoloader

# Sobreescribir la configuración de Nginx de la imagen webdevops con la nuestra optimizada
COPY docker/nginx.prod.conf /opt/docker/etc/nginx/vhost.conf

# Copiar la configuración de supervisor para ejecutar Reverb y la cola en producción
COPY docker/laravel-workers.conf /opt/docker/etc/supervisor.d/laravel-workers.conf
RUN sed -i 's/\r$//' /opt/docker/etc/supervisor.d/laravel-workers.conf

# Copiar script de init para migraciones y cache (se ejecuta ANTES del entrypoint de webdevops)
COPY docker/laravel-init.sh /opt/docker/bin/entrypoint.d/99-laravel-init.sh
RUN chmod +x /opt/docker/bin/entrypoint.d/99-laravel-init.sh
RUN sed -i 's/\r$//' /opt/docker/bin/entrypoint.d/99-laravel-init.sh
